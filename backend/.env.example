# =============================================================================
# Variables de entorno — Copiar a .env y ajustar valores
# =============================================================================

# Database (Neon serverless Postgres)
# Ejemplo Neon: postgresql://neondb_owner:npg_xxxxx@ep-xxxxx-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://usuario:password@host:puerto/dbname?sslmode=require"

# JWT
JWT_SECRET="cambiar_por_secreto_seguro_en_produccion"
JWT_EXPIRATION="24h"

# App
PORT=3000
NODE_ENV=production
FRONTEND_URL="https://tu-frontend.vercel.app"

# File uploads
MAX_FILE_SIZE=5242880
UPLOAD_PATH="./uploads"