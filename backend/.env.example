# =============================================================================
# Variables de entorno — Copiar a .env y ajustar valores
# =============================================================================

# Neon pooled connection URL (hostname includes -pooler); used by the running API.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Neon direct/unpooled URL; used only for Prisma migrations and database backups.
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# JWT
JWT_SECRET="cambiar_por_secreto_seguro_en_produccion"
JWT_EXPIRATION="24h"

# App
PORT=3000
NODE_ENV=production
FRONTEND_URL="https://tu-frontend.vercel.app"

# File uploads
MAX_FILE_SIZE=5242880
UPLOAD_PATH="./uploads"

# Production: keep automatic local backups disabled; use Neon backup/PITR.
MAINTENANCE_AUTO_BACKUP=false
# Optional; on Render set this under the persistent disk mount, e.g. /app/uploads/backups
MAINTENANCE_BACKUP_DIR="./uploads/backups"
